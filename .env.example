# ============================================================
# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交到 Git。
#
# 配置优先级：系统环境变量 > .env > 代码默认值。
# 也就是说，临时想覆盖某个值，可以直接在终端设置环境变量。
# ============================================================

# ---------- 大模型（必填） ----------
# DeepSeek 控制台申请的 API Key；不填时问答接口会返回 503。
DEEPSEEK_API_KEY=
# deepseek-chat / deepseek-reasoner 已进入退役计划，默认使用 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- Agent ----------
# Agent 默认使用 deepseek-flash；AGENT_* 留空时会回退到上面的 DEEPSEEK_*。
AGENT_MODEL=deepseek-flash
AGENT_BASE_URL=https://api.deepseek.com
AGENT_API_KEY=
AGENT_TEMPERATURE=0.1
# 单次回答最大 token 数
AGENT_MAX_TOKENS=2048
# 多轮对话只发送最近 N 轮（一轮 = 用户 + 助手）
AGENT_MAX_HISTORY_TURNS=6
# LangGraph 最大递归步数，限制工具循环次数
AGENT_RECURSION_LIMIT=12

# ---------- Agent 工具来源 ----------
# local：只用进程内 LangChain 工具（改造前行为）
# mcp：  只通过 FastMCP 服务加载工具，连接失败直接报错
# auto： 优先 MCP，失败后回退 local（默认）
AGENT_TOOL_SOURCE=auto
MCP_SERVER_NAME=rag-kb
# Agent 连接的 MCP Streamable HTTP 地址
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# 加载工具列表的超时/最大尝试次数；Docker 启动时 MCP 可能晚几秒就绪
MCP_CONNECT_TIMEOUT=3.0
MCP_CONNECT_RETRIES=2
MCP_RETRY_INTERVAL=1.0
# 单次 MCP 工具调用超时；检索包含 embedding
MCP_REQUEST_TIMEOUT=30.0

# ---------- MCP 服务自身 ----------
# HTTP 监听地址；stdio 模式忽略这两个值
MCP_HOST=127.0.0.1
MCP_PORT=8001
# MCP 服务调用 FastAPI 只读接口的地址
KB_API_BASE_URL=http://127.0.0.1:8000
KB_API_TIMEOUT=30.0

# ---------- 本地向量模型 ----------
# Ollama 服务地址；先用 ollama pull qwen3-embedding:0.6b 下载模型。
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ---------- 向量库 ----------
# Chroma 数据目录；Docker 部署时建议挂载到宿主机。
CHROMA_DIR=./data/chroma
COLLECTION_NAME=knowledge_base

# ---------- 检索参数 ----------
# TOP_K 越大召回越多，但噪声和 token 成本也越高。
TOP_K=5
# cosine 距离阈值：越小越严格。换模型/换文档后要用评测集重新校准，
# 不要直接照搬 0.6。
MAX_DISTANCE=0.6

# ---------- 混合检索 ----------
# false：纯向量检索（baseline，行为和加 BM25 之前一致）
# true： 向量召回 + BM25 召回，用 RRF 融合
HYBRID_ENABLED=false
# 两路各召回多少条，再融合；一般设为最终 TOP_K 的 2 倍左右
DENSE_TOP_K=10
SPARSE_TOP_K=10
# RRF 平滑常数，常用 60；越大越弱化“单路第一名”的优势
RRF_K=60
# BM25 参数：k1 控制词频饱和，b 控制文档长度归一化
BM25_K1=1.5
BM25_B=0.75

# ---------- 切分参数（第 1 个练习的变量） ----------
# 建议对比 300/50、500/100、800/150 三组，记录 Hit@5 变化。
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---------- 生成与上传限制 ----------
# 送入模型的最大上下文字符数，控制 token 成本。
MAX_CONTEXT_CHARS=6000
# 单个上传文件大小上限（MB）。
MAX_UPLOAD_MB=20
